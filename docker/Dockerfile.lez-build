# Builder for logos-lez-rln's tools (mint_payer, run_setup, fund_account) and its
# guest programs. `harness.sh build` runs docker/build-lez.sh in it: as
# linux/amd64 with the host's docker socket for the guest programs
# (cargo-risczero builds them in docker), natively for the tools.
FROM rust:1-bookworm
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins/docker-buildx \
     /usr/local/libexec/docker/cli-plugins/docker-buildx
# libpcsclite: the tools link it (keycard_wallet).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libpcsclite-dev pkg-config clang llvm cmake protobuf-compiler git curl unzip && \
    rm -rf /var/lib/apt/lists/*
